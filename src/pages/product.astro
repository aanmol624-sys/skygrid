---
import DeepPage from '../layouts/DeepPage.astro';
import Icon from '../components/Icon.astro';
import Proposed from '../components/Proposed.astro';
import d from '../data/deliverables.json';
const pc: Record<string, string> = { learn: 'var(--learn)', innovate: 'var(--innovate)', impact: 'var(--impact)' };
// Illustrative environment types (from the site-strategy logic: exact sites are determined through feasibility)
const envs = [
  { name: 'Agricultural environment', icon: 'field', c: 'var(--learn)', text: 'Precision agriculture and partner-defined farm problems.' },
  { name: 'Rural / environmental environment', icon: 'compass', c: 'var(--innovate)', text: 'Environmental monitoring and mapping.' },
  { name: 'Infrastructure / industrial environment', icon: 'node', c: 'var(--impact)', text: 'Infrastructure inspection and industry challenges.' },
];
---
<DeepPage title="What does UFV receive for $100M?" eyebrow="The Product" pillar="impact"
  crumbs={[{ label: 'The Product' }]}
  intro={`${d.intro} SkyGrid is a system of systems.`}
  toc={[{ id: 'deliverables', label: '14 finished deliverables' }, { id: 'system', label: 'System of systems' }, { id: 'environments', label: 'Field environments' }]}>
  <section id="deliverables" class="scroll-mt-24">
    <h2 class="text-2xl font-bold">14 finished deliverables</h2>
    <p class="text-muted mt-2">Hover, focus or tap a card to see what UFV receives.</p>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-3 mt-6">
      {d.items.map((it) => (
        <li class="flip" tabindex="0" style={`--c:${pc[it.pillar]}`}>
          <div class="flip-inner">
            <div class="flip-face card p-5 flex flex-col">
              <div class="flex items-start justify-between">
                <span class="w-12 h-12 rounded-xl grid place-items-center" style="color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent)"><Icon name={it.icon} size={26} /></span>
                <span class="mono text-3xl font-bold text-line-strong">{String(it.n).padStart(2, '0')}</span>
              </div>
              <p class="font-bold text-lg mt-auto pt-6 leading-snug" style="font-family: var(--font-display)">{it.name}</p>
            </div>
            <div class="flip-face flip-back card p-5 flex flex-col" style="border-color: var(--c)">
              <p class="eyebrow" style="color: var(--c)">What UFV receives</p>
              <p class="text-sm mt-3 leading-relaxed">{it.receives}</p>
              {(it.n === 2 || it.n === 11) && <div class="mt-auto pt-3"><Proposed label="Proposed target" /></div>}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="system" class="pt-24 scroll-mt-24">
    <h2 class="text-2xl font-bold">A system of systems</h2>
    <div class="equation mt-8 flex flex-wrap items-center gap-2 sm:gap-3 text-xl sm:text-3xl font-bold" style="font-family: var(--font-display)" id="equation">
      {d.equation.map((term, i) => (
        <>
          <span class="term px-3 sm:px-4 py-2 rounded-xl border border-line-strong" data-term={i} style={`--d:${i * 250}ms`}>{term}</span>
          {i < d.equation.length - 1 ? <span class="op text-muted" style={`--d:${i * 250 + 120}ms`}>+</span> : <span class="op text-muted" style={`--d:${i * 250 + 120}ms`}>=</span>}
        </>
      ))}
      <span class="term result px-4 py-2 rounded-xl" style={`--d:${d.equation.length * 250}ms`}>SkyGrid</span>
    </div>
    <ul class="mt-10 space-y-3 max-w-3xl" id="incomplete">
      {d.incomplete.map((line, i) => (
        <li class="card p-4 cursor-default text-lg" data-missing={[0, 1, 2, 3][i]}>{line}</li>
      ))}
    </ul>
    <p class="text-sm text-muted mt-3">Hover a sentence to see which piece goes missing.</p>
  </section>

  <section id="environments" class="pt-24 scroll-mt-24">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-2xl font-bold">Fraser Valley Field-Test Network</h2>
      <span class="pill pill-illustrative">Illustrative</span>
      <Proposed label="≥3 proposed target" />
    </div>
    <p class="text-muted mt-2 max-w-3xl">Illustrative, exact sites determined through feasibility. We deliberately do not put pins on a real map: site access cannot be assumed before feasibility and rights-holder engagement.</p>
    <div class="grid md:grid-cols-3 gap-4 mt-6">
      {envs.map((e, i) => (
        <div class="card p-6 relative overflow-hidden" style={`border-top: 3px solid ${e.c}`}>
          <svg class="absolute -right-6 -bottom-6 opacity-20" width="160" height="160" viewBox="0 0 160 160" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((k) => <ellipse cx="80" cy="80" rx={70 - k * 13} ry={45 - k * 8} fill="none" stroke={e.c} />)}
          </svg>
          <span style={`color:${e.c}`}><Icon name={e.icon} size={30} /></span>
          <p class="mono text-xs text-muted mt-4">ENVIRONMENT {String.fromCharCode(65 + i)} · SITE TBD</p>
          <p class="font-bold text-lg mt-1">{e.name}</p>
          <p class="text-sm text-muted mt-2">{e.text}</p>
        </div>
      ))}
    </div>
  </section>
</DeepPage>

<style>
  .flip { perspective: 1000px; min-height: 210px; outline: none; }
  .flip-inner { position: relative; width: 100%; height: 100%; min-height: 210px; transition: transform .6s cubic-bezier(.2,.8,.2,1); transform-style: preserve-3d; }
  .flip:hover .flip-inner, .flip:focus-visible .flip-inner, .flip.flipped .flip-inner { transform: rotateY(180deg); }
  .flip-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .flip-back { transform: rotateY(180deg); background: var(--surface-solid); }
  .flip:focus-visible .flip-face { box-shadow: 0 0 0 2px var(--impact); }
  @media (prefers-reduced-motion: reduce) { .flip-inner { transition: none; } }

  .js .equation .term, .js .equation .op { opacity: 0; transform: translateY(10px); transition: opacity .5s var(--d), transform .5s var(--d), filter .3s, opacity .3s; }
  .js .equation.in .term, .js .equation.in .op { opacity: 1; transform: none; }
  .result { background: linear-gradient(90deg, var(--learn), var(--innovate), var(--impact)); color: #0B1220; }
  .equation .term.missing { opacity: .2 !important; filter: grayscale(1); text-decoration: line-through; }
</style>
<script>
  // Tap to flip on touch devices
  document.querySelectorAll<HTMLElement>('.flip').forEach((f) => f.addEventListener('click', () => f.classList.toggle('flipped')));
  // Equation builds when visible
  const eq = document.getElementById('equation')!;
  new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { eq.classList.add('in'); o.disconnect(); } }), { threshold: 0.4 }).observe(eq);
  // "Incomplete without…" greys out the missing piece
  document.querySelectorAll<HTMLElement>('[data-missing]').forEach((li) => {
    const on = () => { eq.querySelector(`[data-term="${li.dataset.missing}"]`)?.classList.add('missing'); eq.querySelector('.result')?.classList.add('missing'); };
    const off = () => eq.querySelectorAll('.missing').forEach((t) => t.classList.remove('missing'));
    li.addEventListener('mouseenter', on); li.addEventListener('mouseleave', off);
    li.tabIndex = 0; li.addEventListener('focus', on); li.addEventListener('blur', off);
  });
</script>
