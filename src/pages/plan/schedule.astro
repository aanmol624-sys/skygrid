---
import DeepPage from '../../layouts/DeepPage.astro';
import Gantt from '../../components/islands/Gantt.tsx';
import Proposed from '../../components/Proposed.astro';
import s from '../../data/schedule.json';
const statusColor: Record<string, string> = { Green: 'var(--learn)', Amber: 'var(--impact)', Red: 'var(--danger)' };
---
<DeepPage title="Schedule & Gantt" eyebrow="The Plan · Schedule" pillar="innovate"
  crumbs={[{ label: 'The Plan' }, { label: 'Schedule / Gantt' }]}
  intro="The WBS defines what SkyGrid must deliver; the schedule converts those outputs into sequence, duration, dependencies, milestones, and accountability. The external deadline remains September 1, 2030, but the proposed internal operational-acceptance target is August 15, 2030 so the team does not plan to finish on the deadline itself."
  toc={[{ id: 'gantt', label: 'Master Gantt' }, { id: 'critical', label: 'Critical path' }, { id: 'control', label: 'Schedule control' }]}>
  <section id="gantt" class="pt-4 scroll-mt-24">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <h2 class="text-2xl font-bold">Proposed SkyGrid master Gantt chart</h2>
      <Proposed label="Proposed baseline" />
    </div>
    <p class="text-sm text-muted mb-6 max-w-3xl">Team-developed baseline schedule derived from the WBS and stage-gate model. M1–M7 are milestones (gates, final operational acceptance, and launch). Bars are coloured by accountable role; hover or focus a bar for timing, role and predecessor.</p>
    <Gantt client:load />
  </section>

  <section id="critical" class="pt-20 scroll-mt-24">
    <h2 class="text-2xl font-bold">7.1 Provisional critical path</h2>
    <ol class="flex flex-wrap items-center gap-2 mt-6">
      {s.criticalPath.map((step, i) => (
        <li class="flex items-center gap-2">
          <span class:list={['px-3 py-1.5 rounded-lg text-sm border', step.startsWith('Gate') ? 'mono font-semibold' : '']}
            style={step.startsWith('Gate') ? 'background: var(--impact); color: var(--on-impact); border-color: var(--impact)' : 'border-color: color-mix(in srgb, var(--danger) 50%, transparent); background: color-mix(in srgb, var(--danger) 8%, transparent)'}>{step}</span>
          {i < s.criticalPath.length - 1 && <span class="text-danger" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
    <p class="text-muted mt-6 max-w-3xl leading-relaxed">{s.criticalNote}</p>
  </section>

  <section id="control" class="pt-20 scroll-mt-24">
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-2xl font-bold">7.2 Schedule control</h2><Proposed label="Proposed triggers" />
    </div>
    <div class="grid md:grid-cols-3 gap-4 mt-6">
      {s.controls.map((c) => (
        <div class="card p-5">
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full" style={`background:${statusColor[c.status]};box-shadow:0 0 16px ${statusColor[c.status]}`}></span>
            <span class="mono font-bold tracking-wider uppercase" style={`color:${statusColor[c.status]}`}>{c.status}</span>
          </div>
          <p class="mt-4 text-sm"><span class="eyebrow block mb-1">Trigger</span>{c.trigger}</p>
          <p class="mt-3 text-sm"><span class="eyebrow block mb-1">Management response</span>{c.response}</p>
        </div>
      ))}
    </div>
    <h3 class="text-lg font-semibold mt-12">Proposed recovery sequence</h3>
    <ol class="mt-5 space-y-2">
      {s.recovery.map((r, i) => (
        <li class="flex items-center gap-4" style={`margin-left:${i * 1.5}rem`}>
          <span class="mono text-sm w-8 h-8 rounded-lg grid place-items-center shrink-0 border border-line-strong">{i + 1}</span>
          <span class="card px-4 py-2.5 text-sm">{r}</span>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm font-semibold">Safety and regulatory requirements are not compressed merely to protect the launch date.</p>
  </section>
</DeepPage>
