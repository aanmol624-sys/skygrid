---
import DeepPage from '../../layouts/DeepPage.astro';
import GateRibbon from '../../components/GateRibbon.astro';
import Cite from '../../components/Cite.astro';
import Proposed from '../../components/Proposed.astro';
import Icon from '../../components/Icon.astro';
import g from '../../data/governance.json';
import s from '../../data/schedule.json';
---
<DeepPage title="Delivery Approach — Prove Before We Spend" eyebrow="The Plan · Delivery & Gates" pillar="innovate"
  crumbs={[{ label: 'The Plan' }, { label: 'Delivery & Gates' }]}
  toc={[{ id: 'hybrid', label: 'Hybrid method' }, { id: 'gates', label: 'Stage gates' }, { id: 'phases', label: 'Phases & decisions' }, { id: 'mission', label: 'Mission before aircraft' }, { id: 'waves', label: 'Wave procurement' }]}>
  <p slot="header" class="mt-6 text-xl sm:text-2xl max-w-4xl font-semibold leading-snug" style="font-family: var(--font-display)">Core control principle: SkyGrid does not receive an unconditional $100M spending commitment on Day 1. <span class="text-impact">Each major investment stage must earn permission to proceed.</span></p>

  <section id="hybrid" class="scroll-mt-24">
    <h2 class="text-2xl font-bold">A hybrid, stage-gated delivery approach</h2>
    <p class="text-muted mt-3 max-w-3xl leading-relaxed">PMI describes hybrid delivery as combining predictive and adaptive practices for projects with different degrees of certainty and change <Cite ids="pmi-nd" label="PMI, n.d." />.</p>
    <div class="mt-8 space-y-3">
      <div class="lane card p-5 grid md:grid-cols-[220px_1fr] gap-4 items-center" style="border-left: 3px solid var(--innovate)">
        <div><p class="mono text-xs text-innovate">PREDICTIVE LANE</p><p class="font-semibold mt-1">Where requirements must be controlled</p></div>
        <div class="flex flex-wrap gap-2">
          {['Facilities', 'Sites', 'Major capital procurement', 'Regulatory deliverables', 'Budgets', 'Milestone dates'].map((x) => <span class="px-3 py-1.5 rounded-md text-sm border border-line" style="background: color-mix(in srgb, var(--innovate) 8%, transparent)">{x}</span>)}
          <span class="w-full h-1.5 rounded-full mt-1" style="background: linear-gradient(90deg, var(--innovate), color-mix(in srgb, var(--innovate) 30%, transparent))"></span>
        </div>
      </div>
      <div class="lane card p-5 grid md:grid-cols-[220px_1fr] gap-4 items-center" style="border-left: 3px solid var(--learn)">
        <div><p class="mono text-xs text-learn">ADAPTIVE LANE</p><p class="font-semibold mt-1">Work that will evolve 2026–2030</p></div>
        <div class="flex flex-wrap gap-2">
          {['Software', 'Analytics', 'Prototypes', 'Research use cases', 'Partner pilots', 'Selected technology configurations'].map((x) => <span class="px-3 py-1.5 rounded-md text-sm border border-line" style="background: color-mix(in srgb, var(--learn) 8%, transparent)">{x}</span>)}
          <span class="w-full h-1.5 rounded-full mt-1 iter"></span>
        </div>
      </div>
    </div>
  </section>

  <section id="gates" class="pt-20 scroll-mt-24">
    <div class="flex flex-wrap items-center gap-3"><h2 class="text-2xl font-bold">Seven phases, five gates (kill points)</h2><Proposed label="Team design" /></div>
    <p class="text-muted mt-2 mb-12">Select a gate diamond to see what it takes to continue, redirect or stop.</p>
    <GateRibbon interactive />
    <div class="grid sm:grid-cols-5 gap-2 mt-2">
      {g.gates.map((x) => (
        <button type="button" data-gate={x.n} class="card p-3 text-left hover:border-[var(--impact)] transition-colors">
          <p class="mono text-xs text-impact">GATE {x.n} · {x.date}</p>
          <p class="font-semibold text-sm mt-1">Prove {x.short.replace('Prove ', '')}</p>
        </button>
      ))}
    </div>
    <p class="text-xs text-muted mt-4">Source: Team-developed delivery model; hybrid-method rationale is consistent with PMI guidance <Cite ids="pmi-nd" label="PMI, n.d." />.</p>
  </section>

  {g.gates.map((x) => (
    <dialog id={`gate-${x.n}`} data-lenis-prevent class="modal" aria-labelledby={`gate-title-${x.n}`}>
      <div class="w-[min(900px,calc(100vw-2rem))] card p-6 sm:p-8" style="background: var(--surface-solid)">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="mono text-xs text-impact">{x.date}</p>
            <h3 id={`gate-title-${x.n}`} class="text-2xl font-bold mt-1">{x.name}</h3>
            <p class="text-muted">{x.short}</p>
          </div>
          <button type="button" data-close class="w-9 h-9 grid place-items-center rounded-lg border border-line" aria-label="Close"><Icon name="x" /></button>
        </div>
        <div class="grid md:grid-cols-3 gap-3 mt-6">
          <div class="rounded-xl p-4 border" style="border-color: color-mix(in srgb, var(--learn) 45%, transparent); background: color-mix(in srgb, var(--learn) 7%, transparent)">
            <p class="mono font-bold text-learn">✓ CONTINUE only if…</p>
            <p class="text-sm mt-2 leading-relaxed">{x.continue}</p>
          </div>
          <div class="rounded-xl p-4 border md:col-span-2" style="border-color: color-mix(in srgb, var(--impact) 45%, transparent); background: color-mix(in srgb, var(--impact) 7%, transparent)">
            <p class="mono font-bold text-impact">↻ REDIRECT <span class="text-muted">/</span> <span class="text-danger">✕ STOP</span> — examples</p>
            <p class="text-sm mt-2 leading-relaxed">{x.redirect}</p>
          </div>
        </div>
      </div>
    </dialog>
  ))}

  <section id="phases" class="pt-20 scroll-mt-24">
    <h2 class="text-2xl font-bold">Phases, periods, and decisions</h2>
    <div class="overflow-x-auto card mt-6">
      <table class="tbl">
        <thead><tr><th>Phase</th><th>Period</th><th>What must happen</th><th>Decision / output</th></tr></thead>
        <tbody>{s.phases.map((p) => <tr><td class="font-semibold">{p.n}. {p.name}</td><td class="mono whitespace-nowrap">{p.period}</td><td>{p.work}</td><td class:list={[p.decision.startsWith('Gate') && 'text-impact font-semibold']}>{p.decision}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="mission" class="pt-20 scroll-mt-24">
    <h2 class="text-2xl font-bold">6.2 Mission before aircraft</h2>
    <p class="text-muted mt-3 max-w-3xl leading-relaxed">Transport Canada’s rules make operating category and technical capability inseparable. Advanced and Level 1 Complex operations can require specific RPAS Safety Assurance declarations, and aircraft must be used within declared operational capabilities <Cite ids={['tc-2025a', 'tc-2026e']} label="Transport Canada, 2025a, 2026e" />.</p>
    <ol class="chevrons mt-8 flex flex-col md:flex-row">
      {g.missionBeforeAircraft.map((m, i) => (
        <li class="chev flex-1" style={`--c: ${['var(--learn)', 'var(--learn)', 'var(--innovate)', 'var(--innovate)', 'var(--impact)'][i]}`}>
          <span class="mono text-[.65rem] opacity-70">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-semibold">{m}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="waves" class="pt-20 scroll-mt-24">
    <div class="flex flex-wrap items-center gap-3"><h2 class="text-2xl font-bold">6.3 Proposed wave procurement</h2><Proposed label="Team design" /></div>
    <p class="text-muted mt-3 max-w-3xl">The three-wave structure is a team design decision intended to reduce technology-obsolescence risk; it is not a requirement imposed by Transport Canada or PMI.</p>
    <div class="relative mt-10">
      <div class="absolute left-0 right-0 top-6 h-0.5 bg-line-strong hidden md:block"></div>
      <div class="grid md:grid-cols-3 gap-6">
        {g.waves.map((w, i) => (
          <div class="relative">
            <div class="w-12 h-12 rounded-full grid place-items-center mono font-bold relative z-[1] border-2" style={`border-color: var(--innovate); background: var(--bg); box-shadow: 0 0 ${10 + i * 8}px -2px var(--innovate)`}>{w.timing.slice(2)}</div>
            <p class="mono text-sm text-innovate mt-4">{w.wave} · {w.timing}</p>
            <p class="mt-2 text-[.95rem]">{w.purpose}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</DeepPage>

<style>
  .iter { background: repeating-linear-gradient(90deg, var(--learn) 0 40px, transparent 40px 52px); opacity: .8; }
  .chev { position: relative; display: flex; flex-direction: column; justify-content: center; padding: 1rem 1.5rem 1rem 2.2rem; min-height: 76px;
    background: color-mix(in srgb, var(--c) 16%, var(--bg)); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); }
  @media (min-width: 768px) {
    .chev { clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 50%, calc(100% - 18px) 100%, 0 100%, 18px 50%); margin-left: -10px; border: 0; }
    .chev:first-child { clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 50%, calc(100% - 18px) 100%, 0 100%); margin-left: 0; padding-left: 1.25rem; }
  }
  @media (max-width: 767px) { .chev { border-radius: 8px; margin-bottom: 6px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-gate]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(`gate-${b.dataset.gate}`) as HTMLDialogElement).showModal()));
</script>
