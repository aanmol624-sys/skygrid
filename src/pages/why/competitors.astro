---
import DeepPage from '../../layouts/DeepPage.astro';
import Cite from '../../components/Cite.astro';
import TeamAnalysis from '../../components/TeamAnalysis.astro';
import b from '../../data/benchmarks.json';
const colors = ['var(--learn)', 'var(--innovate)', 'var(--impact)'];
---
<DeepPage title="Why SkyGrid Is Not Just Another Drone Lab" eyebrow="Why SkyGrid · Competitors" pillar="innovate"
  crumbs={[{ label: 'Why SkyGrid' }, { label: 'Competitors' }]}
  intro={b.intro}>
  <div class="flex flex-wrap items-center gap-3 mb-6"><h2 class="text-2xl font-bold">Benchmark evidence and lessons for SkyGrid</h2><TeamAnalysis /></div>
  <p class="text-sm text-muted mb-6">Each card shows the evidence; hover, focus or tap it to see the SkyGrid lesson.</p>
  <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {b.comparators.map((c, i) => (
      <li>
        <div class="flip" tabindex="0">
        <div class="flip-inner">
          <div class="flip-face card p-5 flex flex-col">
            <p class="mono text-xs text-muted">{String(i + 1).padStart(2, '0')} · EVIDENCE</p>
            <p class="text-xl font-bold mt-1" style="font-family: var(--font-display)">{c.name}</p>
            <p class="text-sm mt-3 leading-relaxed">{c.evidence}</p>
          </div>
          <div class="flip-face flip-back card p-5 flex flex-col justify-center" style="border-color: var(--impact)">
            <p class="eyebrow text-impact">SkyGrid lesson</p>
            <p class="text-lg font-semibold mt-3 leading-snug" style="font-family: var(--font-display)">{c.lesson}</p>
          </div>
        </div>
        </div>
        <div class="mt-2"><Cite ids={c.cite[0] as string[]} label={c.cite[1] as string} /></div>
      </li>
    ))}
  </ol>

  <section class="mt-20">
    <p class="eyebrow">12.1 Final competitive position</p>
    <p class="text-2xl sm:text-3xl font-bold mt-3 max-w-4xl leading-snug" style="font-family: var(--font-display)">{b.position}</p>
    <p class="text-muted mt-5 max-w-3xl leading-relaxed">{b.positionDetail}</p>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-bold">12.2 Build–Buy–Partner strategy</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-6">
      {b.bbp.map((x, i) => (
        <div class="card p-6" style={`border-top: 3px solid ${colors[i]}`}>
          <p class="mono text-2xl font-bold tracking-wider" style={`color:${colors[i]}`}>{x.choice}</p>
          <p class="text-muted mt-3 leading-relaxed">{x.use}</p>
        </div>
      ))}
    </div>
    <blockquote class="mt-10 text-xl sm:text-2xl font-semibold max-w-4xl leading-snug border-l-2 pl-6" style="border-color: var(--impact); font-family: var(--font-display)">{b.statement}</blockquote>
  </section>
</DeepPage>
<style>
  .flip { perspective: 1000px; min-height: 290px; outline: none; }
  .flip-inner { position: relative; width: 100%; height: 100%; min-height: 290px; transition: transform .6s cubic-bezier(.2,.8,.2,1); transform-style: preserve-3d; }
  .flip:hover .flip-inner, .flip:focus-visible .flip-inner, .flip.flipped .flip-inner { transform: rotateY(180deg); }
  .flip-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .flip-back { transform: rotateY(180deg); background: var(--surface-solid); }
  .flip:focus-visible .flip-face { box-shadow: 0 0 0 2px var(--impact); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.flip').forEach((f) => f.addEventListener('click', (e) => {
    f.classList.toggle('flipped');
  }));
</script>
