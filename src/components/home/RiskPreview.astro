---
import Chapter from './Chapter.astro';
import Icon from '../Icon.astro';
import Proposed from '../Proposed.astro';
import HeatMap from '../islands/HeatMap.tsx';
---
<Chapter n={7} title="What could go wrong — and who owns it."
  deeper={{ label: 'Go deeper: full risk register', href: 'risk' }}
  notes="Risk (1:00 · Ishmeet). 12 risks on a 5×5 map. R3 cost escalation (20, critical) and R4 technology obsolescence (16, critical) pulse red. Every risk has an owner and a response. R6 safety gets mandatory controls regardless of score. Three shields: SMS, cyber threat-risk assessment, privacy by design.">
  <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-12 items-center">
    <div class="reveal max-w-[520px] w-full">
      <HeatMap compact client:visible />
    </div>
    <div class="reveal">
      <p class="text-3xl sm:text-4xl font-bold leading-tight" style="font-family: var(--font-display)"><span class="mono text-danger">12</span> risks, every one owned and every one with a response.</p>
      <p class="text-muted mt-4 flex flex-wrap items-center gap-2">Scores are planning judgments, not measured probabilities. <Proposed label="Proposed scores" /></p>
      <ul class="mt-8 grid sm:grid-cols-3 gap-3">
        {['Safety Management System', 'Cybersecurity threat-risk assessment', 'Privacy by design'].map((s) => (
          <li class="card p-4 flex flex-col gap-2">
            <span class="text-learn"><Icon name="shield" size={26} /></span>
            <span class="font-semibold text-sm">{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Chapter>
