---
import Chapter from './Chapter.astro';
import TermSheet from '../TermSheet.astro';
import Icon from '../Icon.astro';
import DroneLogo from '../DroneLogo.astro';
import team from '../../data/responsibility.json';
import { u } from '../../lib/site';
---
<Chapter n={10} title="The Ask."
  notes="The Ask (0:45 · All). Read the term sheet line by line: CAD $100,000,000; released gate by gate; 14 finished deliverables; September 1, 2030; protected by 5 kill points, $10M contingency, $5M reserve and a 4-level change authority. Each member says one sentence. Press Fund SkyGrid.">
  <div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10 items-center">
    <div class="desk reveal rounded-3xl p-4 sm:p-10">
      <div class="rotate-[-1.2deg]"><TermSheet /></div>
    </div>
    <div class="reveal">
      <p class="eyebrow mb-4">The team</p>
      <ul class="grid grid-cols-3 gap-3">
        {team.members.map((m, i) => (
          <li class="text-center">
            <span class="avatar mx-auto" style={`--c: ${['var(--learn)', 'var(--innovate)', 'var(--impact)'][i % 3]}`} role="img" aria-label={`${m.name} (initials ${m.initials})`}>{m.initials}</span>
            <p class="font-semibold text-sm mt-2">{m.name}</p>
            <p class="text-[.7rem] text-muted leading-snug">{m.role}</p>
          </li>
        ))}
      </ul>
      <div class="mt-10 relative">
        <button type="button" id="fund-btn" class="btn btn-primary text-lg !px-8 !py-4 w-full sm:w-auto justify-center">
          <span class="fund-drone"><DroneLogo size={26} /></span> Fund SkyGrid
        </button>
        <div id="fund-done" class="hidden mt-6 card p-5" role="status">
          <p class="font-semibold text-lg flex items-center gap-2"><span class="text-learn"><Icon name="check" /></span> Cleared for launch — T-minus <span class="mono text-impact" id="fund-count"></span> days.</p>
          <p class="text-muted text-sm mt-1">The Decision Pack contains the high-level plan, the charter and the Gantt chart.</p>
          <a href={u('downloads/UFV-SkyGrid-Decision-Pack.pdf')} download class="btn btn-primary btn-sm mt-4"><Icon name="download" size={15} /> Download the Decision Pack (PDF)</a>
        </div>
      </div>
    </div>
  </div>
</Chapter>

<style>
  .desk {
    background:
      radial-gradient(70% 60% at 50% 40%, rgba(245,165,36,.10), transparent 70%),
      linear-gradient(160deg, #2A1E16, #18110C);
    box-shadow: inset 0 0 80px rgba(0,0,0,.6);
  }
  .avatar { width: clamp(56px, 18vw, 80px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; font: 700 1.4rem/1 var(--font-display); color: var(--c); border: 2px solid var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); box-shadow: 0 0 24px -8px var(--c); }
  .fund-drone { display: inline-block; }
  .launching .fund-drone { animation: liftoff 1.6s cubic-bezier(.5,0,.75,0) forwards; }
  @keyframes liftoff {
    0% { transform: translateY(0); }
    20% { transform: translateY(2px) rotate(-4deg); }
    100% { transform: translateY(-140vh) rotate(8deg); opacity: 0; }
  }
  .flash { animation: flash .25s 6 alternate; }
  @keyframes flash { to { color: var(--learn); text-shadow: 0 0 18px var(--learn); } }
</style>

<script>
  import { LAUNCH_DATE } from '../../lib/site';
  const btn = document.getElementById('fund-btn');
  btn?.addEventListener('click', () => {
    const days = Math.max(0, Math.ceil((new Date(LAUNCH_DATE).getTime() - Date.now()) / 86400000)).toLocaleString('en-CA');
    btn.classList.add('launching');
    const cd = document.getElementById('countdown');
    cd?.classList.add('flash');
    setTimeout(() => {
      const done = document.getElementById('fund-done')!;
      document.getElementById('fund-count')!.textContent = days;
      done.classList.remove('hidden');
      document.getElementById('fund-count')!.classList.add('flash');
      btn.classList.remove('launching');
    }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1400);
  });
</script>
