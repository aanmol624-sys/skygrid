---
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
---
<svg class={`drone-logo ${cls}`} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <path d="M9 9l5 5M23 9l-5 5M9 23l5-5M23 23l-5-5" />
  </g>
  <rect x="12.5" y="12.5" width="7" height="7" rx="2" fill="var(--impact)" />
  {[[7, 7], [25, 7], [7, 25], [25, 25]].map(([cx, cy]) => (
    <g class="rotor" style={`transform-origin:${cx}px ${cy}px`}>
      <ellipse cx={cx} cy={cy} rx="5.2" ry="1.4" fill="currentColor" opacity=".8" />
      <circle cx={cx} cy={cy} r="1.3" fill="var(--innovate)" />
    </g>
  ))}
</svg>
<style>
  .rotor { transition: transform .4s; }
  :global(a:hover) .rotor, :global(button:hover) .rotor { animation: spin .35s linear infinite; }
</style>
