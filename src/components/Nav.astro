---
import { NAV, u, CHAPTERS } from '../lib/site';
import Icon from './Icon.astro';
import DroneLogo from './DroneLogo.astro';
interface Props { isHome?: boolean }
const { isHome = false } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const active = (href: string) => path.startsWith('/' + href.split('#')[0]);
// Exact current page (section links with #anchors never count as "here")
const isHere = (href: string) => !href.includes('#') && path.replace(/\/$/, '') === '/' + href;

// Phone/tablet menu: the desktop dropdown groups plus the standalone pages, each with an icon and one-liner.
const pillarOf: Record<string, string> = { 'The Plan': 'innovate', 'The Investment': 'impact', 'Why SkyGrid': 'learn' };
const MENU = [
  ...NAV.filter((n) => 'children' in n).map((n) => ({ label: n.label, pillar: pillarOf[n.label], items: [...(n as any).children] })),
  {
    label: 'Explore', pillar: 'muted',
    items: [
      { label: 'The Product', href: 'product', icon: 'node', desc: 'What UFV receives for $100M: 14 finished deliverables.' },
      { label: 'Risk & Safety', href: 'risk', icon: 'shield', desc: '12 risks, every one owned and every one with a response.' },
      { label: 'Team', href: 'team', icon: 'people', desc: 'Roles, responsibilities and the deliverable matrix.' },
      { label: 'Evidence', href: 'evidence', icon: 'doc', desc: 'The full, searchable APA 7 reference list.' },
    ],
  },
] as { label: string; pillar: string; items: { label: string; href: string; icon: string; desc: string }[] }[];
---
<header id="site-nav" class:list={['fixed top-0 inset-x-0 z-50 h-16 transition-colors duration-300 no-print', { 'nav-transparent': isHome }]}>
  <nav class="h-full max-w-[1400px] mx-auto px-4 sm:px-6 flex items-center gap-4" aria-label="Main">
    <a href={u('/')} class="flex items-center gap-2.5 shrink-0 group" aria-label="UFV SkyGrid home">
      <DroneLogo />
      <span class="font-display font-bold text-[1.05rem] tracking-tight" style="font-family: var(--font-display)">UFV <span class="text-impact">SkyGrid</span></span>
    </a>

    <ul class="hidden xl:flex items-center gap-1 mx-auto text-[.88rem]">
      {NAV.map((item) => 'children' in item ? (
        <li class="mega relative">
          <button type="button" class:list={['mega-btn px-3 py-2 rounded-lg flex items-center gap-1 hover:bg-[color-mix(in_srgb,var(--text)_7%,transparent)]', { 'text-impact': item.children.some((c) => active(c.href)) }]} aria-expanded="false">
            {item.label} <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.5"/></svg>
          </button>
          <div class="mega-panel absolute left-1/2 top-full pt-3">
            <div class="mega-box rounded-2xl p-3 grid gap-2 shadow-2xl border border-line-strong" style={`width:min(${item.children.length > 3 ? 640 : 520}px, calc(100vw - 32px)); grid-template-columns: repeat(${item.children.length > 4 ? 3 : 2}, 1fr)`}>
              {item.children.map((c) => (
                <a href={u(c.href)} class="mega-tile rounded-xl p-3 flex flex-col gap-1.5 border border-transparent hover:border-line-strong hover:bg-[color-mix(in_srgb,var(--text)_5%,transparent)]">
                  <span class="text-innovate"><Icon name={c.icon} size={20} /></span>
                  <span class="font-semibold text-[.9rem]">{c.label}</span>
                  <span class="text-muted text-[.78rem] leading-snug">{c.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      ) : (
        <li><a href={u(item.href)} class:list={['px-3 py-2 rounded-lg block hover:bg-[color-mix(in_srgb,var(--text)_7%,transparent)]', { 'text-impact': active(item.href) }]}>{item.label}</a></li>
      ))}
    </ul>

    <div class="ml-auto xl:ml-0 flex items-center gap-1.5">
      <a href={u('evidence#search')} class="icon-btn" aria-label="Search references"><Icon name="search" size={18} /></a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle light or dark theme">
        <span class="theme-dark"><Icon name="sun" size={18} /></span><span class="theme-light"><Icon name="moon" size={18} /></span>
      </button>
      <a href={isHome ? '#present' : u('/?present=1')} data-present class="btn btn-ghost btn-sm hidden md:inline-flex"><Icon name="play" size={13} /> Present</a>
      <button type="button" data-open="term-sheet" class="btn btn-primary btn-sm hidden sm:inline-flex">Fund SkyGrid · <span class="mono">$100M</span></button>
      <button type="button" id="menu-open" class="icon-btn xl:hidden" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><Icon name="menu" size={22} /></button>
    </div>
  </nav>

  <!-- Flight-path progress bar -->
  <div class="absolute left-0 right-0 bottom-0 h-[2px]" aria-hidden="true">
    <div class="absolute inset-0 bg-line"></div>
    {isHome && CHAPTERS.map((_, i) => <span class="chapter-tick absolute top-[-2px] w-px h-[6px] bg-line-strong" data-tick={i}></span>)}
    <div id="progress-fill" class="absolute left-0 top-0 h-full" style="width:0; background: linear-gradient(90deg, var(--learn), var(--innovate), var(--impact))">
      <svg class="absolute -right-2.5 -top-[9px]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--impact)" stroke-width="1.8" stroke-linecap="round"><path d="M5 5a2 2 0 1 0 0 .01M19 5a2 2 0 1 0 0 .01M5 19a2 2 0 1 0 0 .01M19 19a2 2 0 1 0 0 .01M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3"/><rect x="10" y="10" width="4" height="4" fill="var(--impact)"/></svg>
    </div>
  </div>
</header>

<!-- Mobile full-screen menu -->
<div id="mobile-menu" data-lenis-prevent class="fixed inset-0 z-[70] bg-bg hidden flex-col overflow-y-auto no-print" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="menu-bg absolute inset-0 pointer-events-none contours" aria-hidden="true"></div>
  <div class="sticky top-0 z-10 h-16 shrink-0 px-4 sm:px-8 flex items-center justify-between border-b border-line" style="background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px)">
    <a href={u('/')} class="flex items-center gap-2.5"><DroneLogo size={30} /><span class="font-bold text-lg" style="font-family: var(--font-display)">UFV <span class="text-impact">SkyGrid</span></span></a>
    <button type="button" id="menu-close" class="menu-close" aria-label="Close menu"><Icon name="x" size={22} /></button>
  </div>

  <div class="relative w-full max-w-5xl mx-auto px-4 sm:px-8 pt-6 pb-28 sm:pb-12">
    <!-- Quick actions -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 menu-in" style="--i:0">
      <a href={isHome ? '#present' : u('/?present=1')} data-present class="quick">
        <span class="quick-icon" style="--c: var(--innovate)"><Icon name="play" size={18} /></span>
        <span><span class="block font-semibold">Present the pitch</span><span class="block text-xs text-muted">15-minute Presentation Mode</span></span>
      </a>
      <button type="button" data-open="term-sheet" class="quick quick-primary text-left">
        <span class="quick-icon" style="--c: var(--on-impact)"><Icon name="coin" size={18} /></span>
        <span><span class="block font-semibold">Fund SkyGrid</span><span class="block text-xs opacity-80 mono">CAD $100,000,000</span></span>
      </button>
      <a href={u('investor-room')} class:list={['quick', { 'is-here': isHere('investor-room') }]}>
        <span class="quick-icon" style="--c: var(--learn)"><Icon name="check" size={18} /></span>
        <span><span class="block font-semibold">Investor Room</span><span class="block text-xs text-muted">Every marking line, answered</span></span>
      </a>
    </div>

    <!-- Sections -->
    <div class="grid md:grid-cols-2 gap-4 mt-6">
      {MENU.map((sec, si) => (
        <section class="menu-card menu-in" style={`--i:${si + 1}; --c: var(--${sec.pillar})`}>
          <p class="flex items-center gap-2 mb-2 px-1">
            <span class="w-2 h-2 rounded-full" style="background: var(--c); box-shadow: 0 0 10px var(--c)"></span>
            <span class="eyebrow" style="color: var(--c)">{sec.label}</span>
            <span class="mono text-[.65rem] text-muted ml-auto">{String(sec.items.length).padStart(2, '0')}</span>
          </p>
          <ul class="space-y-1">
            {sec.items.map((c) => (
              <li>
                <a href={u(c.href)} class:list={['menu-link', { 'is-here': isHere(c.href) }]} aria-current={isHere(c.href) ? 'page' : undefined}>
                  <span class="menu-link-icon"><Icon name={c.icon} size={18} /></span>
                  <span class="min-w-0">
                    <span class="flex items-center gap-2 font-semibold">{c.label}{isHere(c.href) && <span class="mono text-[.58rem] uppercase tracking-wider px-1.5 py-0.5 rounded" style="color: var(--c); border: 1px solid var(--c)">You are here</span>}</span>
                    <span class="block text-[.8rem] text-muted leading-snug line-clamp-2">{c.desc}</span>
                  </span>
                  <span class="menu-arrow ml-auto shrink-0"><Icon name="arrow" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Footer row -->
    <div class="menu-in flex flex-wrap items-center gap-3 mt-6 pt-5 border-t border-line" style={`--i:${MENU.length + 1}`}>
      <button type="button" data-theme-toggle class="btn btn-ghost btn-sm">
        <span class="theme-dark flex items-center gap-2"><Icon name="sun" size={15} /> Light mode</span>
        <span class="theme-light items-center gap-2"><Icon name="moon" size={15} /> Dark mode</span>
      </button>
      <a href={u('evidence#search')} class="btn btn-ghost btn-sm"><Icon name="search" size={15} /> Search references</a>
      <p class="italic text-sm text-muted sm:ml-auto">“Where Autonomous Aviation Meets the Real World.”</p>
    </div>
  </div>
</div>

<!-- Mobile sticky bottom bar -->
<div class="fixed bottom-0 inset-x-0 z-40 sm:hidden glass border-t border-line p-3 grid grid-cols-2 gap-2 no-print" id="mobile-bar">
  <button type="button" data-open="video-modal" class="btn btn-ghost btn-sm justify-center"><Icon name="play" size={13} /> Watch Pitch</button>
  <button type="button" data-open="term-sheet" class="btn btn-primary btn-sm justify-center">Fund <span class="mono">$100M</span></button>
</div>

<style>
  #site-nav:not(.nav-transparent), #site-nav.scrolled {
    background: var(--surface);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  /* Over the (always dark) home hero the bar is transparent, so keep its colours dark-theme even in light mode. */
  #site-nav.nav-transparent:not(.scrolled) {
    --text: #E6EDF7; --muted: #8A97AD; --line: rgba(138,151,173,.18); --line-strong: rgba(138,151,173,.35);
    --surface-solid: #131C2E; --innovate: #38BDF8; --impact: #F5A524; --on-impact: #1A1206;
    color: var(--text);
  }
  .icon-btn { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; color: var(--text); }
  .icon-btn:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
  @media (min-width: 1280px) { #menu-open { display: none; } }
  /* Centred under its button; --shift (set in site.ts) nudges it back on screen near the edges. */
  .mega-panel { opacity: 0; visibility: hidden; transform: translate(calc(-50% + var(--shift, 0px)), 6px); transition: opacity .18s ease, visibility .18s ease, transform .18s ease; }
  .mega:hover .mega-panel, .mega:focus-within .mega-panel, .mega.open .mega-panel { opacity: 1; visibility: visible; transform: translate(calc(-50% + var(--shift, 0px)), 0); }
  /* Solid background: a frosted backdrop can't blur inside the already-blurred nav bar, so it showed the page through. */
  .mega-box { background: var(--surface-solid); }
  :global([data-theme="light"]) .theme-dark, .theme-light { display: none !important; }
  :global([data-theme="light"]) .theme-light { display: inline-flex !important; }

  /* ── Phone / tablet menu ── */
  .menu-bg { opacity: .8; background-color: transparent; }
  .menu-bg::after { content: ''; position: absolute; inset: 0; background:
      radial-gradient(60% 40% at 90% 0%, color-mix(in srgb, var(--impact) 12%, transparent), transparent 70%),
      radial-gradient(50% 40% at 0% 100%, color-mix(in srgb, var(--innovate) 12%, transparent), transparent 70%); }
  .menu-close { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; border: 1px solid var(--line-strong); color: var(--text); transition: background .2s, transform .2s; }
  .menu-close:hover { background: color-mix(in srgb, var(--text) 8%, transparent); transform: rotate(90deg); }
  .quick { display: flex; align-items: center; gap: .85rem; padding: .9rem 1rem; border-radius: 14px; border: 1px solid var(--line-strong); background: var(--surface-solid); color: var(--text); transition: transform .2s, border-color .2s, box-shadow .2s; }
  .quick:hover { transform: translateY(-2px); border-color: var(--text); }
  .quick.is-here { border-color: var(--learn); }
  .quick-primary { background: var(--impact); border-color: var(--impact); color: var(--on-impact); }
  .quick-primary:hover { border-color: var(--impact); box-shadow: 0 10px 30px -10px var(--impact); }
  .quick-icon { width: 38px; height: 38px; flex-shrink: 0; display: grid; place-items: center; border-radius: 10px; color: var(--c); background: color-mix(in srgb, var(--c) 15%, transparent); }
  .menu-card { padding: 1rem; border-radius: 18px; border: 1px solid var(--line); border-top: 2px solid var(--c); background: color-mix(in srgb, var(--surface-solid) 92%, transparent); }
  .menu-link { display: flex; align-items: center; gap: .85rem; padding: .7rem .6rem; border-radius: 12px; border: 1px solid transparent; color: var(--text); transition: background .2s, border-color .2s; }
  .menu-link:hover, .menu-link:focus-visible { background: color-mix(in srgb, var(--c) 9%, transparent); border-color: color-mix(in srgb, var(--c) 35%, transparent); }
  .menu-link.is-here { background: color-mix(in srgb, var(--c) 12%, transparent); border-color: color-mix(in srgb, var(--c) 50%, transparent); }
  .menu-link-icon { width: 38px; height: 38px; flex-shrink: 0; display: grid; place-items: center; border-radius: 11px; color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); border: 1px solid color-mix(in srgb, var(--c) 25%, transparent); }
  .menu-arrow { color: var(--muted); opacity: 0; transform: translateX(-4px); transition: .2s; }
  .menu-link:hover .menu-arrow, .menu-link:focus-visible .menu-arrow { opacity: 1; transform: none; color: var(--c); }
  @media (hover: none) { .menu-arrow { opacity: .6; transform: none; } }
  #mobile-menu.flex .menu-in { animation: menu-in .45s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i) * 60ms); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(14px); } }
</style>
