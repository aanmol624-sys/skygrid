---
import { ICONS } from '../lib/icons';
interface Props { name: string; size?: number; class?: string; stroke?: number }
const { name, size = 20, class: cls = '', stroke = 1.7 } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={ICONS[name] ?? ICONS.doc} />
</svg>
